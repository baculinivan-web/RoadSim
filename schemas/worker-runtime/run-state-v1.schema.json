{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roadsim.dev/schemas/worker-runtime/run-state-v1.schema.json",
  "title": "RoadSim worker run state journal entry v1",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "creation_sequence",
    "transition_sequence",
    "state",
    "diagnostic_code"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": { "enum": ["failed", "incomplete"] }
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "diagnostic_code": { "type": "string" }
        }
      },
      "else": {
        "properties": {
          "diagnostic_code": { "type": "null" }
        }
      }
    }
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "session_id": { "type": "integer", "minimum": 0 },
    "creation_sequence": { "type": "integer", "minimum": 0 },
    "transition_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "state": {
      "enum": [
        "starting",
        "running",
        "completed",
        "cancelled",
        "failed",
        "incomplete"
      ]
    },
    "diagnostic_code": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9._-]+$"
        }
      ]
    }
  }
}
